// Prisma schema for H12 rental business
// Using Neon PostgreSQL with separate schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["h12"]
}

// Vehicle types
enum VehicleType {
  CAR
  MOTO

  @@schema("h12")
}

// Quote/Booking status
enum QuoteStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@schema("h12")
}

model Vehicle {
  id           String      @id @default(cuid())
  type         VehicleType
  name         String
  category     String
  price        Int
  period       String      @default("jour")
  image        String
  description  String?
  features     String[]
  fuel         String?
  seats        Int?
  transmission String?
  year         Int?
  power        String?
  available    Boolean     @default(true)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  quotes Quote[]

  @@index([type])
  @@index([available])
  @@schema("h12")
}

model Quote {
  id              String      @id @default(cuid())
  status          QuoteStatus @default(PENDING)

  // Service info
  serviceType     String
  vehicleId       String?
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])
  vehicleName     String?
  vehiclePrice    Int?

  // Booking details
  pickupDate      DateTime?
  pickupTime      String?
  returnDate      DateTime?
  pickupLocation  String?
  pickupZone      String?
  dropoffLocation String?
  deliveryCity    String?
  wantsDriver     Boolean     @default(false)
  numberOfPeople  Int?

  // Excursions (stored as JSON)
  excursions      Json?

  // Contact info
  fullName        String
  phone           String
  email           String?
  notes           String?

  // Pricing
  rentalDays      Int?
  totalPrice      Int?

  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reviewedAt      DateTime?

  @@index([status])
  @@index([createdAt])
  @@schema("h12")
}
