generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["h12"]
}

model Vehicle {
  id           String      @id @default(cuid())
  type         VehicleType
  name         String
  category     String
  price        Int
  period       String      @default("jour")
  image        String
  description  String?
  features     String[]
  fuel         String?
  seats        Int?
  transmission String?
  year         Int?
  power        String?
  available    Boolean     @default(true)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quotes       Quote[]

  @@index([type])
  @@index([available])
  @@schema("h12")
}

model Quote {
  id              String         @id @default(cuid())
  status          QuoteStatus    @default(PENDING)
  serviceType     String
  vehicleId       String?
  vehicleName     String?
  vehiclePrice    Int?
  pickupDate      DateTime?
  pickupTime      String?
  returnDate      DateTime?
  pickupLocation  String?
  pickupZone      String?
  dropoffLocation String?
  deliveryCity    String?
  wantsDriver     Boolean        @default(false)
  numberOfPeople  Int?
  excursions      Json?
  fullName        String
  phone           String
  email           String?
  notes           String?
  rentalDays      Int?
  totalPrice      Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  reviewedAt      DateTime?
  transferRouteId String?
  reference       String?        @unique
  transferRoute   TransferRoute? @relation(fields: [transferRouteId], references: [id])
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([transferRouteId])
  @@schema("h12")
}

model Excursion {
  id          String   @id @default(cuid())
  name        String
  category    String
  price       Int
  period      String   @default("personne")
  image       String
  description String
  features    String[]
  highlights  String[]
  duration    String?
  groupSize   String?
  departure   String?
  difficulty  String?
  rating      Float    @default(5.0)
  reviews     Int      @default(0)
  favorite    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@schema("h12")
}

model TransferRoute {
  id          String           @id @default(cuid())
  name        String
  category    TransferCategory
  price1to4   Int?
  price5to8   Int?
  price9to17  Int?
  price18to48 Int?
  distance    String?
  duration    String?
  popular     Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  quotes      Quote[]

  @@index([category])
  @@index([isActive])
  @@schema("h12")
}

model Admin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("createdat")
  email     String   @unique
  password  String
  name      String?

  @@map("Admin")
  @@schema("h12")
}

enum VehicleType {
  CAR
  MOTO

  @@schema("h12")
}

enum QuoteStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@schema("h12")
}

enum TransferCategory {
  AIRPORT
  CITY
  EXCURSION
  NIGHTLIFE

  @@schema("h12")
}
