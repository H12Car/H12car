// Prisma schema for H12 rental business
// Using Neon PostgreSQL with separate schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["h12"]
}

// Vehicle types
enum VehicleType {
  CAR
  MOTO

  @@schema("h12")
}

// Quote/Booking status
enum QuoteStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@schema("h12")
}

model Vehicle {
  id           String      @id @default(cuid())
  type         VehicleType
  name         String
  category     String
  price        Int
  period       String      @default("jour")
  image        String
  description  String?
  features     String[]
  fuel         String?
  seats        Int?
  transmission String?
  year         Int?
  power        String?
  available    Boolean     @default(true)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  quotes Quote[]

  @@index([type])
  @@index([available])
  @@schema("h12")
}

model Quote {
  id              String      @id @default(cuid())
  reference       String?     @unique // e.g., "H12-ABC123" for easy lookup
  status          QuoteStatus @default(PENDING)

  // Service info
  serviceType     String
  vehicleId       String?
  vehicle         Vehicle?    @relation(fields: [vehicleId], references: [id])
  vehicleName     String?
  vehiclePrice    Int?

  // Booking details
  pickupDate      DateTime?
  pickupTime      String?
  returnDate      DateTime?
  pickupLocation  String?
  pickupZone      String?
  dropoffLocation String?
  deliveryCity    String?
  wantsDriver     Boolean     @default(false)
  numberOfPeople  Int?

  // Excursions (stored as JSON)
  excursions      Json?

  // Transfer info (for transfer bookings)
  transferRouteId String?
  transferRoute   TransferRoute? @relation(fields: [transferRouteId], references: [id])

  // Contact info
  fullName        String
  phone           String
  email           String?
  notes           String?

  // Pricing
  rentalDays      Int?
  totalPrice      Int?

  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reviewedAt      DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([transferRouteId])
  @@schema("h12")
}

// Excursion model
model Excursion {
  id          String   @id @default(cuid())
  name        String
  category    String   // e.g., "Palmeraie", "Aventure", "Extrême", "Pack"
  price       Int      // Price per person in MAD
  period      String   @default("personne")
  image       String   // Image URL (Uploadcare or /public)
  description String

  // Details
  features    String[] // e.g., ["Transport A/R", "Guide berbère"]
  highlights  String[] // e.g., ["Palmeraie de Marrakech", "Villages berbères"]
  duration    String?  // e.g., "1 heure", "2-3 heures"
  groupSize   String?  // e.g., "1-8", "1-12"
  departure   String?  // e.g., "Multiple", "09:00 / 14:00"
  difficulty  String?  // e.g., "Facile", "Modéré", "Sportif"

  // Display
  rating      Float    @default(5.0)
  reviews     Int      @default(0)
  favorite    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@schema("h12")
}

// Transfer route category
enum TransferCategory {
  AIRPORT
  CITY
  EXCURSION
  NIGHTLIFE

  @@schema("h12")
}

// Transfer routes with pricing tiers
model TransferRoute {
  id          String           @id @default(cuid())
  name        String           // e.g., "Aéroport Marrakech (RAK)"
  category    TransferCategory

  // Pricing per passenger range (in MAD H.T)
  price1to4   Int?             // 1-4 passengers (Berline/Van)
  price5to8   Int?             // 5-8 passengers (Minivan)
  price9to17  Int?             // 9-17 passengers (Minibus)
  price18to48 Int?             // 18-48 passengers (Bus)

  // Route details
  distance    String?          // e.g., "6 km"
  duration    String?          // e.g., "15-30 min"

  // Display options
  popular     Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)

  // Timestamps
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  quotes      Quote[]

  @@index([category])
  @@index([isActive])
  @@schema("h12")
}
